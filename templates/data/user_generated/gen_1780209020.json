15);\n        }\n        .nav-dot:hover {\n            background: rgba(255, 255, 255, 0.5);\n        }\n\n        /* ---- 箭头导航 ---- */\n        .nav-arrows {\n            position: absolute;\n            top: 50%;\n            left: 0;\n            right: 0;\n            transform: translateY(-50%);\n            display: flex;\n            justify-content: space-between;\n            padding: 0 10px;\n            z-index: 20;\n            pointer-events: none;\n        }\n        .nav-arrow {\n            width: 44px;\n            height: 44px;\n            border-radius: 50%;\n            background: rgba(11, 26, 48, 0.7);\n            backdrop-filter: blur(6px);\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 18px;\n            color: var(--color-text);\n            cursor: pointer;\n            pointer-events: all;\n            transition: background 0.3s, border-color 0.3s, transform 0.2s;\n            user-select: none;\n            font-family: var(--font-body);\n        }\n        .nav-arrow:hover {\n            background: rgba(201, 168, 76, 0.2);\n            border-color: var(--color-secondary);\n            transform: scale(1.05);\n        }\n        .nav-arrow:active {\n            transform: scale(0.95);\n        }\n\n        /* ---- 页码指示器 ---- */\n        .page-indicator {\n            position: absolute;\n            bottom: 14px;\n            right: 50px;\n            font-family: var(--font-body);\n            font-size: 13px;\n            color: var(--color-text-muted);\n            letter-spacing: 1px;\n            z-index: 20;\n            opacity: 0.7;\n        }\n        .page-indicator .current {\n            color: var(--color-secondary);\n            font-weight: 700;\n        }\n\n        /* ---- 附加装饰：斜线组合（使用 SVG） ---- */\n        .deco-slant {\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 300px;\n            height: 200px;\n            pointer-events: none;\n            z-index: 1;\n            opacity: 0.3;\n        }\n        .deco-slant svg {\n            width: 100%;\n            height: 100%;\n        }\n\n        /* 金色圆点（右上锚点） */\n        .deco-gold-dot--top-right {\n            top: 22px;\n            right: 30px;\n        }\n\n        /* 底部微光条 */\n        .deco-glow-bar--bottom {\n            bottom: 0;\n            left: 0;\n        }\n\n        /* 额外安全边距辅助 */\n        .content-padding {\n            padding: 0;\n        }\n\n        /* ---- 响应式辅助（保持比例） ---- */\n        @media (max-width: 1300px) {\n            .slides-wrapper {\n                transform: scale(0.85);\n                transform-origin: center center;\n            }\n        }\n        @media (max-width: 1100px) {\n            .slides-wrapper {\n                transform: scale(0.7);\n            }\n        }\n        @media (max-width: 900px) {\n            .slides-wrapper {\n                transform: scale(0.55);\n            }\n        }\n        @media (max-width: 700px) {\n            .slides-wrapper {\n                transform: scale(0.4);\n                transform-origin: center center;\n            }\n            body {\n                align-items: flex-start;\n                padding-top: 20px;\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"slides-wrapper\" id=\"slidesWrapper\">\n        <div class=\"slides-track\" id=\"slidesTrack\">\n\n            <!-- ===== SLIDE 1: 封面页 (cover) ===== -->\n            <div class=\"slide cover\">\n                <!-- 装饰：斜线组合 + 金色圆点 -->\n                <div class=\"deco-slant\">\n                    <svg viewBox=\"0 0 300 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <line x1=\"300\" y1=\"0\" x2=\"60\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.3\" />\n                        <line x1=\"300\" y1=\"20\" x2=\"100\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.2\" />\n                        <line x1=\"300\" y1=\"40\" x2=\"140\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.15\" />\n                        <circle cx=\"280\" cy=\"18\" r=\"4\" fill=\"#C9A84C\" opacity=\"0.9\" />\n                    </svg>\n                </div>\n                <!-- 四角装饰线 -->\n                <div class=\"deco-corner deco-corner--tl\"></div>\n                <div class=\"deco-corner deco-corner--tr\"></div>\n                <div class=\"deco-corner deco-corner--bl\"></div>\n                <div class=\"deco-corner deco-corner--br\"></div>\n                <!-- 底部微光 -->\n                <div class=\"deco-glow-bar deco-glow-bar--bottom\"></div>\n\n                <!-- 主内容 -->\n                <div class=\"cover-main\">\n                    <h1>智驭未来 · <span class=\"gold\">INNOVATE</span></h1>\n                    <p class=\"subtitle\">2025 全球战略发布会 · 重塑商业新格局</p>\n                    <div class=\"date-badge\">✦ 2025.04 · 上海 ✦</div>\n                </div>\n\n                <!-- 底部线 -->\n                <div class=\"cover-bottom-line\"></div>\n\n                <!-- footer -->\n                <div class=\"slide-footer\">\n                    <span class=\"page-num\">01</span> / 05\n                </div>\n            </div>\n\n            <!-- ===== SLIDE 2: 目录页 (toc) ===== -->\n            <div class=\"slide toc\">\n                <!-- 装饰 -->\n                <div class=\"deco-slant\">\n                    <svg viewBox=\"0 0 300 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <line x1=\"300\" y1=\"0\" x2=\"60\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.2\" />\n                        <line x1=\"300\" y1=\"30\" x2=\"110\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.12\" />\n                        <circle cx=\"280\" cy=\"18\" r=\"4\" fill=\"#C9A84C\" opacity=\"0.6\" />\n                    </svg>\n                </div>\n                <div class=\"deco-corner deco-corner--tl\"></div>\n                <div class=\"deco-corner deco-corner--tr\"></div>\n                <div class=\"deco-corner deco-corner--bl\"></div>\n                <div class=\"deco-corner deco-corner--br\"></div>\n                <div class=\"deco-glow-bar deco-glow-bar--bottom\"></div>\n\n                <!-- page-title -->\n                <div class=\"page-title\">内容矩阵</div>\n\n                <!-- page-content -->\n                <div class=\"page-content\">\n                    <!-- 目录列表 -->\n                    <div class=\"toc-list\">\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">01</span>\n                            <span>战略升维 · 宏观洞察与行业趋势</span>\n                            <span class=\"toc-label\">04</span>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">02</span>\n                            <span>技术破界 · AI 驱动的新一代引擎</span>\n                            <span class=\"toc-label\">10</span>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">03</span>\n                            <span>生态共赢 · 全球合作伙伴计划</span>\n                            <span class=\"toc-label\">18</span>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">04</span>\n                            <span>品牌焕新 · 视觉与体验的全面跃迁</span>\n                            <span class=\"toc-label\">26</span>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">05</span>\n                            <span>愿景共启 · 迈向可持续未来</span>\n                            <span class=\"toc-label\">34</span>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"slide-footer\">\n                    <span class=\"page-num\">02</span> / 05\n                </div>\n            </div>\n\n            <!-- ===== SLIDE 3: 章节页 (section) ===== -->\n            <div class=\"slide section\">\n                <!-- 装饰 -->\n                <div class=\"deco-slant\">\n                    <svg viewBox=\"0 0 300 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <line x1=\"300\" y1=\"0\" x2=\"60\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.25\" />\n                        <line x1=\"300\" y1=\"25\" x2=\"95\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.15\" />\n                        <circle cx=\"278\" cy=\"16\" r=\"4\" fill=\"#C9A84C\" opacity=\"0.7\" />\n                    </svg>\n                </div>\n                <div class=\"deco-corner deco-corner--tl\"></div>\n                <div class=\"deco-corner deco-corner--tr\"></div>\n                <div class=\"deco-corner deco-corner--bl\"></div>\n                <div class=\"deco-corner deco-corner--br\"></div>\n                <div class=\"deco-glow-bar deco-glow-bar--bottom\"></div>\n\n                <!-- chapter_tag -->\n                <div class=\"page-title\">第一章</div>\n\n                <!-- title -->\n                <h1 class=\"section-title\">战略 <span class=\"gold\">升维</span></h1>\n\n                <!-- subtitle -->\n                <p class=\"subtitle\">宏观洞察 · 行业趋势 · 增长新范式</p>\n\n                <div class=\"slide-footer\">\n                    <span class=\"page-num\">03</span> / 05\n                </div>\n            </div>\n\n            <!-- ===== SLIDE 4: 内容页 (content) ===== -->\n            <div class=\"slide content\">\n                <!-- 装饰 -->\n                <div class=\"deco-slant\">\n                    <svg viewBox=\"0 0 300 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <line x1=\"300\" y1=\"0\" x2=\"60\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.2\" />\n                        <line x1=\"300\" y1=\"35\" x2=\"125\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.1\" />\n                        <circle cx=\"282\" cy=\"20\" r=\"4\" fill=\"#C9A84C\" opacity=\"0.6\" />\n                    </svg>\n                </div>\n                <div class=\"deco-corner deco-corner--tl\"></div>\n                <div class=\"deco-corner deco-corner--tr\"></div>\n                <div class=\"deco-corner deco-corner--bl\"></div>\n                <div class=\"deco-corner deco-corner--br\"></div>\n                <div class=\"deco-glow-bar deco-glow-bar--bottom\"></div>\n\n                <!-- page-title -->\n                <div class=\"page-title\">核心洞察</div>\n\n                <!-- page-content 内部完全空白，只留占位符 -->\n                <div class=\"page-content\">{{content}}</div>\n\n                <div class=\"slide-footer\">\n                    <span class=\"page-num\">04</span> / 05\n                </div>\n            </div>\n\n            <!-- ===== SLIDE 5: 结尾页 (ending) ===== -->\n            <div class=\"slide ending\">\n                <!-- 装饰 -->\n                <div class=\"deco-slant\">\n                    <svg viewBox=\"0 0 300 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <line x1=\"300\" y1=\"0\" x2=\"60\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.3\" />\n                        <line x1=\"300\" y1=\"20\" x2=\"100\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.2\" />\n                        <line x1=\"300\" y1=\"40\" x2=\"140\" y2=\"200\" stroke=\"white\" stroke-width=\"0.5\" opacity=\"0.12\" />\n                        <circle cx=\"280\" cy=\"18\" r=\"4\" fill=\"#C9A84C\" opacity=\"0.9\" />\n                    </svg>\n                </div>\n                <div class=\"deco-corner deco-corner--tl\"></div>\n                <div class=\"deco-corner deco-corner--tr\"></div>\n                <div class=\"deco-corner deco-corner--bl\"></div>\n                <div class=\"deco-corner deco-corner--br\"></div>\n                <div class=\"deco-glow-bar deco-glow-bar--bottom\"></div>\n\n                <!-- ending-content -->\n                <div class=\"ending-content\">\n                    <h1>感谢 <span class=\"gold\">关注</span></h1>\n                    <div class=\"ending-divider\"></div>\n                    <p class=\"ending-message\">携手共创 · 智领未来<br />期待与您同行</p>\n                </div>\n\n                <div class=\"slide-footer\">\n                    <span class=\"page-num\">05</span> / 05\n                </div>\n            </div>\n\n        </div>\n        <!-- /slides-track -->\n\n        <!-- 导航点容器（JS 动态生成） -->\n        <div class=\"nav-dots\" id=\"navDots\"></div>\n\n        <!-- 箭头导航 -->\n        <div class=\"nav-arrows\">\n            <div class=\"nav-arrow\" id=\"prevBtn\" onclick=\"prevSlide()\">◀</div>\n            <div class=\"nav-arrow\" id=\"nextBtn\" onclick=\"nextSlide()\">▶</div>\n        </div>\n\n        <!-- 页码指示器 -->\n        <div class=\"page-indicator\">\n            <span class=\"current\" id=\"currentPage\">1</span> / <span id=\"totalPages\">5</span>\n        </div>\n\n    </div>\n    <!-- /slides-wrapper -->\n\n    <script>\n        (function() {\n            'use strict';\n\n            const track = document.getElementById('slidesTrack');\n            const slides = track.querySelectorAll('.slide');\n            const totalSlides = slides.length;\n            let currentIndex = 0;\n\n            // 更新 totalPages 显示\n            document.getElementById('totalPages').textContent = totalSlides;\n\n            // ---- 动态生成导航点 ----\n            const navDots = document.getElementById('navDots');\n            for (let i = 0; i < totalSlides; i++) {\n                const dot = document.createElement('div');\n                dot.className = 'nav-dot' + (i === 0 ? ' active' : '');\n                dot.onclick = (function(idx) {\n                    return function() { goToSlide(idx); };\n                })(i);\n                navDots.appendChild(dot);\n            }\n\n            // ---- 切换函数 ----\n            function goToSlide(index) {\n                if (index < 0) index = 0;\n                if (index >= totalSlides) index = totalSlides - 1;\n                if (index === currentIndex) return;\n\n                currentIndex = index;\n                const offset = -currentIndex * 1280;\n                track.style.transform = 'translateX(' + offset + 'px)';\n\n                // 更新导航点\n                const dots = navDots.querySelectorAll('.nav-dot');\n                dots.forEach(function(d, i) {\n                    d.classList.toggle('active', i === currentIndex);\n                });\n\n                // 更新页码\n                document.getElementById('currentPage').textContent = currentIndex + 1;\n            }\n\n            window.goToSlide = goToSlide;\n\n            window.prevSlide = function() {\n                goToSlide(currentIndex - 1);\n            };\n\n            window.nextSlide = function() {\n                goToSlide(currentIndex + 1);\n            };\n\n            // ---- 键盘支持 ----\n            document.addEventListener('keydown', function(e) {\n                if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {\n                    e.preventDefault();\n                    prevSlide();\n                } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {\n                    e.preventDefault();\n                    nextSlide();\n                } else if (e.key === 'Home') {\n                    e.preventDefault();\n                    goToSlide(0);\n                } else if (e.key === 'End') {\n                    e.preventDefault();\n                    goToSlide(totalSlides - 1);\n                }\n            });\n\n            // ---- 触摸滑动支持 ----\n            let touchStartX = 0;\n            let touchEndX = 0;\n            const wrapper = document.getElementById('slidesWrapper');\n\n            wrapper.addEventListener('touchstart', function(e) {\n                touchStartX = e.changedTouches[0].screenX;\n            }, { passive: true });\n\n            wrapper.addEventListener('touchend', function(e) {\n                touchEndX = e.changedTouches[0].screenX;\n                const diff = touchStartX - touchEndX;\n                if (Math.abs(diff) > 50) {\n                    if (diff > 0) {\n                        nextSlide();\n                    } else {\n                        prevSlide();\n                    }\n                }\n            }, { passive: true });\n\n            // ---- 初始化 ----\n            goToSlide(0);\n\n        })();\n    </script>\n\n</body>\n</html>"
}