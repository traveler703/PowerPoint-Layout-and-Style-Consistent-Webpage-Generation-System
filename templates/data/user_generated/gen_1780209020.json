  "raw_html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>现代商务PPT模板 · 深蓝金韵</title>\n    <!-- Google Fonts -->\n    <link href=\"https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Montserrat:wght@400;700;900&display=swap\" rel=\"stylesheet\" />\n    <style>\n        /* ---- 全局重置 & 变量 ---- */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --color-background: #0B1A30;\n            --color-text: #FFFFFF;\n            --color-text-muted: #A0B0C8;\n            --color-primary: #0B1A30;\n            --color-secondary: #C9A84C;\n            --color-accent: #F5D76E;\n            --color-card: #1C2E4A;\n            --color-surface: #132644;\n            --font-body: 'Lato', 'Noto Sans SC', sans-serif;\n            --font-heading: 'Montserrat', 'Noto Sans SC', sans-serif;\n        }\n\n        body {\n            background: #050e1a;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            font-family: var(--font-body);\n            color: var(--color-text);\n            overflow: hidden;\n            margin: 0;\n            padding: 0;\n        }\n\n        /* ---- 幻灯片外层容器 ---- */\n        .slides-wrapper {\n            width: 1280px;\n            height: 720px;\n            position: relative;\n            overflow: hidden;\n            border-radius: 8px;\n            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);\n            background: var(--color-background);\n        }\n\n        .slides-track {\n            display: flex;\n            width: 100%;\n            height: 100%;\n            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n            will-change: transform;\n        }\n\n        /* ---- 幻灯片通用 ---- */\n        .slide {\n            width: 1280px;\n            height: 720px;\n            position: relative;\n            overflow: hidden;\n            flex-shrink: 0;\n            background: radial-gradient(ellipse at 50% 30%, #132644 0%, #0B1A30 70%);\n        }\n\n        /* ---- 装饰元素（全局通用） ---- */\n        .deco-line-group {\n            position: absolute;\n            top: 0;\n            right: 0;\n            width: 420px;\n            height: 180px;\n            pointer-events: none;\n            z-index: 2;\n        }\n        .deco-line-group svg {\n            width: 100%;\n            height: 100%;\n        }\n\n        .deco-corner {\n            position: absolute;\n            width: 60px;\n            height: 60px;\n            pointer-events: none;\n            z-index: 2;\n            border-color: rgba(255, 255, 255, 0.4);\n            border-style: solid;\n            border-width: 0;\n        }\n        .deco-corner--tl {\n            top: 20px;\n            left: 20px;\n            border-top-width: 1px;\n            border-left-width: 1px;\n        }\n        .deco-corner--tr {\n            top: 20px;\n            right: 20px;\n            border-top-width: 1px;\n            border-right-width: 1px;\n        }\n        .deco-corner--bl {\n            bottom: 20px;\n            left: 20px;\n            border-bottom-width: 1px;\n            border-left-width: 1px;\n        }\n        .deco-corner--br {\n            bottom: 20px;\n            right: 20px;\n            border-bottom-width: 1px;\n            border-right-width: 1px;\n        }\n\n        .deco-glow-bar {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 100%;\n            height: 2px;\n            background: linear-gradient(135deg, var(--color-secondary), transparent 70%);\n            opacity: 0.6;\n            pointer-events: none;\n            z-index: 2;\n        }\n\n        .deco-gold-dot {\n            position: absolute;\n            width: 8px;\n            height: 8px;\n            border-radius: 50%;\n            background: var(--color-secondary);\n            box-shadow: 0 0 12px rgba(201, 168, 76, 0.5);\n            pointer-events: none;\n            z-index: 3;\n        }\n\n        /* ---- 页面标题 & 内容（absolute 定位） ---- */\n        .page-title {\n            position: absolute;\n            top: 40px;\n            left: 60px;\n            font-family: var(--font-heading);\n            font-weight: 700;\n            font-size: 14px;\n            letter-spacing: 3px;\n            text-transform: uppercase;\n            color: var(--color-secondary);\n            z-index: 5;\n        }\n        .page-title::after {\n            content: '';\n            display: block;\n            width: 40px;\n            height: 2px;\n            background: var(--color-secondary);\n            margin-top: 6px;\n            opacity: 0.6;\n        }\n\n        .page-content {\n            position: absolute;\n            top: 130px;\n            left: 60px;\n            right: 60px;\n            bottom: 60px;\n            z-index: 5;\n            overflow: hidden;\n        }\n\n        .slide-footer {\n            position: absolute;\n            bottom: 15px;\n            right: 40px;\n            z-index: 5;\n            font-family: var(--font-body);\n            font-size: 12px;\n            color: var(--color-text-muted);\n            letter-spacing: 1px;\n            display: flex;\n            align-items: center;\n            gap: 6px;\n        }\n        .slide-footer .page-num {\n            color: var(--color-secondary);\n            font-weight: 700;\n        }\n\n        /* ---- 封面页 ---- */\n        .slide.cover {\n            display: block;\n        }\n        .cover .cover-main {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -55%);\n            text-align: center;\n            z-index: 5;\n            width: 80%;\n        }\n        .cover .cover-main h1 {\n            font-family: var(--font-heading);\n            font-weight: 900;\n            font-size: 56px;\n            color: var(--color-text);\n            letter-spacing: 4px;\n            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);\n            margin-bottom: 16px;\n        }\n        .cover .cover-main h1 .gold {\n            color: var(--color-secondary);\n        }\n        .cover .cover-main .subtitle {\n            font-family: var(--font-body);\n            font-weight: 400;\n            font-size: 20px;\n            color: var(--color-text-muted);\n            letter-spacing: 6px;\n            margin-bottom: 30px;\n        }\n        .cover .cover-main .date-badge {\n            display: inline-block;\n            padding: 8px 28px;\n            border: 1px solid var(--color-secondary);\n            border-radius: 30px;\n            font-family: var(--font-body);\n            font-size: 14px;\n            color: var(--color-secondary);\n            letter-spacing: 2px;\n            background: rgba(201, 168, 76, 0.08);\n        }\n        .cover .cover-bottom-line {\n            position: absolute;\n            bottom: 50px;\n            left: 60px;\n            right: 60px;\n            height: 1px;\n            background: linear-gradient(90deg, var(--color-secondary), transparent 70%);\n            opacity: 0.3;\n            z-index: 3;\n        }\n\n        /* ---- 目录页 ---- */\n        .slide.toc .toc-list {\n            display: flex;\n            flex-direction: column;\n            gap: 18px;\n            padding-top: 10px;\n        }\n        .slide.toc .toc-item {\n            display: flex;\n            align-items: center;\n            gap: 20px;\n            font-family: var(--font-heading);\n            font-weight: 400;\n            font-size: 18px;\n            color: var(--color-text);\n            letter-spacing: 1px;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n            padding-bottom: 14px;\n            transition: color 0.2s;\n        }\n        .slide.toc .toc-item .toc-num {\n            font-weight: 900;\n            font-size: 28px;\n            color: var(--color-secondary);\n            width: 50px;\n            text-align: right;\n            opacity: 0.8;\n        }\n        .slide.toc .toc-item .toc-label {\n            font-weight: 400;\n            color: var(--color-text-muted);\n            font-size: 14px;\n            margin-left: auto;\n            opacity: 0.6;\n        }\n\n        /* ---- 章节页 ---- */\n        .slide.section .section-title {\n            position: absolute;\n            top: 50%;\n            left: 60px;\n            right: 60px;\n            transform: translateY(-60%);\n            font-family: var(--font-heading);\n            font-weight: 900;\n            font-size: 64px;\n            color: var(--color-text);\n            text-align: center;\n            letter-spacing: 6px;\n            z-index: 5;\n            line-height: 1.2;\n        }\n        .slide.section .section-title .gold {\n            color: var(--color-secondary);\n        }\n        .slide.section .subtitle {\n            position: absolute;\n            top: 62%;\n            left: 60px;\n            right: 60px;\n            text-align: center;\n            font-family: var(--font-body);\n            font-weight: 400;\n            font-size: 18px;\n            color: var(--color-text-muted);\n            letter-spacing: 4px;\n            z-index: 5;\n        }\n        .slide.section .page-title {\n            top: 120px;\n            left: 50%;\n            transform: translateX(-50%);\n            text-align: center;\n        }\n        .slide.section .page-title::after {\n            margin: 6px auto 0;\n        }\n\n        /* ---- 内容页 ---- */\n        .slide.content .page-content {\n            top: 130px;\n            left: 60px;\n            right: 60px;\n            bottom: 60px;\n            z-index: 5;\n            /* 内部完全空白，只留占位