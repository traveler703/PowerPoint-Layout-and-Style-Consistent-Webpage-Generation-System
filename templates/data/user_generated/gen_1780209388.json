ion: absolute;\n            bottom: 18px;\n            right: 50px;\n            z-index: 3;\n            font-family: var(--font-body);\n            font-size: 13px;\n            color: var(--color-text-muted);\n            opacity: 0.6;\n            letter-spacing: 0.06em;\n        }\n        .slide-footer .page-num {\n            font-weight: 600;\n        }\n\n        /* ===== 导航 ===== */\n        .nav-dots {\n            position: absolute;\n            bottom: 16px;\n            left: 50%;\n            transform: translateX(-50%);\n            display: flex;\n            gap: 12px;\n            z-index: 20;\n        }\n        .nav-dot {\n            width: 10px;\n            height: 10px;\n            border-radius: 50%;\n            background: rgba(58, 42, 26, 0.20);\n            cursor: pointer;\n            transition: all 0.3s ease;\n            border: none;\n            padding: 0;\n        }\n        .nav-dot.active {\n            background: var(--color-primary);\n            width: 30px;\n            border-radius: 6px;\n            box-shadow: 0 0 0 4px rgba(46, 139, 87, 0.15);\n        }\n        .nav-dot:hover {\n            background: var(--color-accent);\n            transform: scale(1.15);\n        }\n\n        .nav-arrows {\n            position: absolute;\n            top: 50%;\n            left: 0;\n            right: 0;\n            transform: translateY(-50%);\n            display: flex;\n            justify-content: space-between;\n            padding: 0 8px;\n            z-index: 18;\n            pointer-events: none;\n        }\n        .nav-arrow {\n            width: 50px;\n            height: 50px;\n            border-radius: 50%;\n            background: rgba(255, 255, 255, 0.75);\n            backdrop-filter: blur(6px);\n            box-shadow: 0 4px 16px rgba(58, 42, 26, 0.12);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 20px;\n            color: var(--color-text);\n            cursor: pointer;\n            pointer-events: auto;\n            transition: all 0.25s ease;\n            user-select: none;\n            border: 1px solid rgba(255, 255, 255, 0.5);\n        }\n        .nav-arrow:hover {\n            background: var(--color-primary);\n            color: #fff;\n            box-shadow: 0 6px 24px rgba(46, 139, 87, 0.30);\n            transform: scale(1.05);\n        }\n        .nav-arrow:active {\n            transform: scale(0.92);\n        }\n\n        .page-indicator {\n            position: absolute;\n            bottom: 20px;\n            left: 50%;\n            transform: translateX(-50%);\n            font-family: var(--font-body);\n            font-size: 13px;\n            color: var(--color-text-muted);\n            opacity: 0.0;\n            pointer-events: none;\n            z-index: 5;\n        }\n\n        /* ===== 装饰树叶 ===== */\n        .leaf-deco {\n            position: absolute;\n            pointer-events: none;\n            z-index: 1;\n            opacity: 0.15;\n            font-size: 80px;\n            user-select: none;\n            transform-origin: center;\n        }\n        .leaf-deco--tl {\n            top: 10px;\n            left: 10px;\n            transform: rotate(-15deg) scale(0.9);\n            opacity: 0.10;\n        }\n        .leaf-deco--tr {\n            top: 8px;\n            right: 16px;\n            transform: rotate(55deg) scale(0.7);\n            opacity: 0.08;\n        }\n        .leaf-deco--bl {\n            bottom: 20px;\n            left: 20px;\n            transform: rotate(-35deg) scale(1.0);\n            opacity: 0.12;\n        }\n        .leaf-deco--br {\n            bottom: 10px;\n            right: 10px;\n            transform: rotate(120deg) scale(0.8);\n            opacity: 0.09;\n        }\n        .leaf-deco--mid {\n            top: 45%;\n            right: 5%;\n            transform: rotate(80deg) scale(1.2);\n            opacity: 0.06;\n        }\n\n        /* 有机曲线分割 */\n        .wave-divider {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 100%;\n            height: 60px;\n            z-index: 1;\n            pointer-events: none;\n            opacity: 0.20;\n        }\n        .wave-divider svg {\n            display: block;\n            width: 100%;\n            height: 100%;\n        }\n\n        /* ===== 1. cover ===== */\n        .slide.cover {\n            background: linear-gradient(145deg, #FDF8F2 0%, #f5ede2 100%);\n        }\n        .slide.cover .cover-bg-leaf {\n            position: absolute;\n            top: -60px;\n            right: -80px;\n            font-size: 280px;\n            opacity: 0.07;\n            transform: rotate(30deg);\n            pointer-events: none;\n            z-index: 0;\n        }\n        .slide.cover .cover-title {\n            position: absolute;\n            top: 140px;\n            left: 70px;\n            z-index: 3;\n            max-width: 700px;\n        }\n        .slide.cover .cover-title h1 {\n            font-family: var(--font-heading);\n            font-size: 68px;\n            font-weight: 700;\n            color: var(--color-text);\n            line-height: 1.15;\n            letter-spacing: -0.01em;\n        }\n        .slide.cover .cover-title h1 .highlight {\n            color: var(--color-primary);\n            position: relative;\n        }\n        .slide.cover .cover-title h1 .highlight::after {\n            content: '';\n            position: absolute;\n            bottom: 6px;\n            left: 0;\n            width: 100%;\n            height: 8px;\n            background: rgba(46, 139, 87, 0.18);\n            border-radius: 4px;\n            z-index: -1;\n        }\n        .slide.cover .subtitle {\n            font-family: var(--font-body);\n            font-size: 22px;\n            font-weight: 300;\n            color: var(--color-text-muted);\n            margin-top: 20px;\n            letter-spacing: 0.08em;\n        }\n        .slide.cover .date-badge {\n            position: absolute;\n            bottom: 90px;\n            left: 70px;\n            z-index: 3;\n            display: inline-block;\n            background: var(--color-primary);\n            color: #fff;\n            padding: 10px 30px;\n            border-radius: 40px;\n            font-family: var(--font-body);\n            font-size: 15px;\n            font-weight: 600;\n            letter-spacing: 0.06em;\n            box-shadow: 0 6px 24px rgba(46, 139, 87, 0.25);\n        }\n        .slide.cover .cover-deco-line {\n            position: absolute;\n            bottom: 70px;\n            left: 70px;\n            width: 120px;\n            height: 3px;\n            background: var(--color-primary);\n            opacity: 0.3;\n            border-radius: 4px;\n            z-index: 2;\n        }\n\n        /* ===== 2. toc ===== */\n        .slide.toc .toc-grid {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 24px 40px;\n            margin-top: 10px;\n        }\n        .slide.toc .toc-item {\n            display: flex;\n            align-items: flex-start;\n            gap: 16px;\n            padding: 14px 20px 14px 0;\n            border-bottom: 1px solid rgba(46, 139, 87, 0.10);\n        }\n        .slide.toc .toc-num {\n            font-family: var(--font-heading);\n            font-size: 32px;\n            font-weight: 700;\n            color: var(--color-primary);\n            opacity: 0.35;\n            line-height: 1;\n            min-width: 48px;\n        }\n        .slide.toc .toc-text {\n            font-family: var(--font-body);\n            font-size: 18px;\n            font-weight: 600;\n            color: var(--color-text);\n            padding-top: 6px;\n        }\n        .slide.toc .toc-text small {\n            display: block;\n            font-weight: 300;\n            font-size: 14px;\n            color: var(--color-text-muted);\n            margin-top: 2px;\n        }\n\n        /* ===== 3. section ===== */\n        .slide.section {\n            background: linear-gradient(160deg, #FDF8F2 0%, #f0ebe0 100%);\n        }\n        .slide.section .section-bg-icon {\n            position: absolute;\n            right: 40px;\n            top: 50%;\n            transform: translateY(-50%);\n            font-size: 200px;\n            opacity: 0.06;\n            pointer-events: none;\n            z-index: 0;\n        }\n        .slide.section .section-title {\n            position: absolute;\n            top: 180px;\n            left: 70px;\n            font-family: var(--font-heading);\n            font-size: 56px;\n            font-weight: 700;\n            color: var(--color-text);\n            z-index: 3;\n            max-width: 700px;\n            line-height: 1.2;\n        }\n        .slide.section .subtitle {\n            position: absolute;\n            top: 300px;\n            left: 70px;\n            font-family: var(--font-body);\n            font-size: 22px;\n            font-weight: 300;\n            color: var(--color-text-muted);\n            z-index: 3;\n            max-width: 540px;\n            letter-spacing: 0.04em;\n            line-height: 1.6;\n        }\n        .slide.section .section-deco {\n            position: absolute;\n            bottom: 80px;\n            left: 70px;\n            width: 80px;\n            height: 3px;\n            background: var(--color-primary);\n            opacity: 0.25;\n            border-radius: 4px;\n            z-index: 2;\n        }\n\n        /* ===== 4. content ===== */\n        .slide.content .content-inner {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 40px;\n            height: 100%;\n            align-content: start;\n        }\n        .slide.content .content-col {\n            padding: 8px 0;\n        }\n        .slide.content .content-col h3 {\n            font-family: var(--font-heading);\n            font-size: 26px;\n            font-weight: 600;\n            color: var(--color-text);\n            margin-bottom: 16px;\n        }\n        .slide.content .content-col h3 .accent-dot {\n            display: inline-block;\n            width: 10px;\n            height: 10px;\n            background: var(--color-primary);\n            border-radius: 50%;\n            margin-right: 12px;\n            vertical-align: middle;\n        }\n        .slide.content .content-col p {\n            font-family: var(--font-body);\n            font-size: 16px;\n            font-weight: 400;\n            color: var(--color-text);\n            line-height: 1.7;\n            margin-bottom: 14px;\n            opacity: 0.85;\n        }\n        .slide.content .content-col .stat-badge {\n            display: inline-block;\n            background: rgba(46, 139, 87, 0.08);\n            padding: 6px 20px;\n            border-radius: 30px;\n            font-size: 15px;\n            font-weight: 600;\n            color: var(--color-primary);\n            border-left: 3px solid var(--color-primary);\n            margin-top: 6px;\n        }\n\n        /* ===== 5. ending ===== */\n        .slide.ending {\n            background: linear-gradient(135deg, #FDF8F2 0%, #eef3e9 100%);\n        }\n        .slide.ending .ending-content {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            text-align: center;\n            z-index: 3;\n            width: 80%;\n            max-width: 700px;\n        }\n        .slide.ending .ending-content h1 {\n            font-family: var(--font-heading);\n            font-size: 54px;\n            font-weight: 700;\n            color: var(--color-text);\n            margin-bottom: 20px;\n            letter-spacing: -0.01em;\n        }\n        .slide.ending .ending-content h1 .highlight-green {\n            color: var(--color-primary);\n        }\n        .slide.ending .ending-content .ending-message {\n            font-family: var(--font-body);\n            font-size: 22px;\n            font-weight: 300;\n            color: var(--color-text-muted);\n            line-height: 1.7;\n            max-width: 500px;\n            margin: 0 auto 30px;\n        }\n        .slide.ending .ending-content .ending-icon {\n            font-size: 56px;\n            opacity: 0.20;\n            margin-bottom: 10px;\n        }\n        .slide.ending .ending-deco-leaf {\n            position: absolute;\n            bottom: 20px;\n            right: 30px;\n            font-size: 120px;\n            opacity: 0.06;\n            transform: rotate(40deg);\n            pointer-events: none;\n            z-index: 0;\n        }\n\n        /* 响应式缩放 */\n        @media (max-width: 1300px) {\n            .slides-wrapper {\n                transform: scale(0.85);\n            }\n        }\n        @media (max-width: 1100px) {\n            .slides-wrapper {\n                transform: scale(0.72);\n            }\n        }\n        @media (max-width: 900px) {\n            .slides-wrapper {\n                transform: scale(0.58);\n            }\n        }\n        @media (max-width: 750px) {\n            .slides-wrapper {\n                transform: scale(0.45);\n            }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"slides-wrapper\" id=\"slidesWrapper\">\n        <div class=\"slides-track\" id=\"slidesTrack\">\n\n            <!-- ========== 1. COVER ========== -->\n            <div class=\"slide cover\">\n                <!-- 装饰树叶 -->\n                <div class=\"leaf-deco leaf-deco--tl\">🌿</div>\n                <div class=\"leaf-deco leaf-deco--br\">🍃</div>\n                <div class=\"leaf-deco leaf-deco--mid\">🌱</div>\n                <div class=\"cover-bg-leaf\">🌳</div>\n\n                <div class=\"cover-title\">\n                    <h1>\n                        在<span class=\"highlight\">自然</span>中<br />重获呼吸感\n                    </h1>\n                    <div class=\"subtitle\">森林疗愈 · 可持续生活 · 教育美学</div>\n                </div>\n\n                <div class=\"date-badge\">✦ 2025 · 润物无声</div>\n                <div class=\"cover-deco-line\"></div>\n\n                <div class=\"slide-footer\"><span class=\"page-num\">01</span></div>\n            </div>\n\n            <!-- ========== 2. TOC ========== -->\n            <div class=\"slide toc\">\n                <div class=\"leaf-deco leaf-deco--tr\">🍂</div>\n                <div class=\"leaf-deco leaf-deco--bl\">🌿</div>\n\n                <div class=\"page-title\">📋 目录</div>\n\n                <div class=\"page-content\">\n                    <div class=\"toc-grid\">\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">01</span>\n                            <div class=\"toc-text\">森林的呼吸 <small>自然疗愈的起点</small></div>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">02</span>\n                            <div class=\"toc-text\">年轮笔记 <small>时间沉淀的智慧</small></div>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">03</span>\n                            <div class=\"toc-text\">树冠之下 <small>社区与共生</small></div>\n                        </div>\n                        <div class=\"toc-item\">\n                            <span class=\"toc-num\">04</span>\n                            <div class=\"toc-text\">新芽计划 <small>教育·行动·未来</small></div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"slide-footer\"><span class=\"page-num\">02</span></div>\n            </div>\n\n            <!-- ========== 3. SECTION ========== -->\n            <div class=\"slide section\">\n                <div class=\"leaf-deco leaf-deco--tl\">🌿</div>\n                <div class=\"leaf-deco leaf-deco--br\">🍃</div>\n                <div class=\"section-bg-icon\">🌲</div>\n\n                <div class=\"page-title\"><span class=\"chapter-tag\">第一章</span></div>\n\n                <h1 class=\"section-title\">森林的呼吸</h1>\n                <p class=\"subtitle\">在树影与光影之间，找回生命本来的节奏。每一片叶子都在诉说疗愈的故事。</p>\n\n                <div class=\"section-deco\"></div>\n\n                <div class=\"slide-footer\"><span class=\"page-num\">03</span></div>\n            </div>\n\n            <!-- ========== 4. CONTENT ========== -->\n            <div class=\"slide content\">\n                <div class=\"leaf-deco leaf-deco--tr\">🌱</div>\n                <div class=\"leaf-deco leaf-deco--bl\">🍂</div>\n\n                <div class=\"page-title\">🌲 树冠之下 · 共生笔记</div>\n\n                <div class=\"page-content\">\n                    <!-- 严格按照规范：page-content 内只放内容，无多余装饰 -->\n                    <div class=\"content-inner\">\n                        <div class=\"content-col\">\n                            <h3><span class=\"accent-dot\"></span> 菌根网络</h3>\n                            <p>树木通过地下菌根真菌彼此连接，形成庞大的“森林之网”。老树通过这张网为幼树输送养分与信号，让整片森林成为一个有感知的生命体。</p>\n                            <div class=\"stat-badge\">✦ 覆盖 90% 的陆生植物</div>\n                        </div>\n                        <div class=\"content-col\">\n                            <h3><span class=\"accent-dot\"></span> 光合诗篇</h3>\n                            <p>一片成年山毛榉的树冠，每天可净化 60 立方米的空气。叶绿素在阳光下将二氧化碳转化为氧气，这是森林写给地球最温柔的情书。</p>\n                            <div class=\"stat-badge\">✦ 每公顷森林日供氧 750 kg</div>\n                        </div>\n                        <div class=\"content-col\">\n                            <h3><span class=\"accent-dot\"></span> 年轮记忆</h3>\n                            <p>树的年轮记录着气候与时光。宽窄之间是雨旱交替，是岁月静好或狂风骤雨。每一圈都是自然的日记，提醒我们敬畏与珍惜。</p>\n                            <div class=\"stat-badge\">✦ 最老树木已存活 9600 年</div>\n                        </div>\n                        <div class=\"content-col\">\n                            <h3><span class=\"accent-dot\"></span> 林间疗愈</h3>\n                            <p>“森林浴”源自日本，研究表明在林间漫步 2 小时，压力激素下降 16%，免疫细胞活性提升 50%。自然是最温和的医生。</p>\n                            <div class=\"stat-badge\">✦ 每周一次森林浴，身心焕新</div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"slide-footer\"><span class=\"page-num\">04</span></div>\n            </div>\n\n            <!-- ========== 5. ENDING ========== -->\n            <div class=\"slide ending\">\n                <div class=\"leaf-deco leaf-deco--tl\">🌿</div>\n                <div class=\"leaf-deco leaf-deco--br\">🍃</div>\n                <div class=\"ending-deco-leaf\">🌳</div>\n\n                <div class=\"ending-content\">\n                    <div class=\"ending-icon\">🍀</div>\n                    <h1>让<span class=\"highlight-green\">自然</span>成为答案</h1>\n                    <p class=\"ending-message\">每一颗种子都藏着森林的蓝图。<br />愿我们以谦卑之心，与万物共呼吸。</p>\n                </div>\n\n                <div class=\"slide-footer\"><span class=\"page-num\">05</span></div>\n            </div>\n\n        </div><!-- end slides-track -->\n\n        <!-- 导航点：JS 动态生成 -->\n        <div class=\"nav-dots\" id=\"navDots\"></div>\n\n        <!-- 箭头导航 -->\n        <div class=\"nav-arrows\">\n            <div class=\"nav-arrow\" id=\"prevBtn\" onclick=\"prevSlide()\">◀</div>\n            <div class=\"nav-arrow\" id=\"nextBtn\" onclick=\"nextSlide()\">▶</div>\n        </div>\n\n        <!-- 页码指示器（隐藏视觉但保留结构） -->\n        <div class=\"page-indicator\"><span class=\"current\" id=\"currentPage\">1</span> / <span id=\"totalPages\">5</span></div>\n    </div>\n\n    <script>\n        (function() {\n            const track = document.getElementById('slidesTrack');\n            const slides = track.querySelectorAll('.slide');\n            const totalSlides = slides.length;\n            let currentIndex = 0;\n\n            // 更新 totalPages 显示\n            document.getElementById('totalPages').textContent = totalSlides;\n\n            // 动态生成导航点\n            const navDots = document.getElementById('navDots');\n            for (let i = 0; i < totalSlides; i++) {\n                const dot = document.createElement('div');\n                dot.className = 'nav-dot' + (i === 0 ? ' active' : '');\n                dot.onclick = (function(idx) {\n                    return function() { goToSlide(idx); };\n                })(i);\n                navDots.appendChild(dot);\n            }\n\n            // 更新导航点状态\n            function updateDots() {\n                const dots = navDots.querySelectorAll('.nav-dot');\n                dots.forEach((dot, idx) => {\n                    dot.classList.toggle('active', idx === currentIndex);\n                });\n                document.getElementById('currentPage').textContent = currentIndex + 1;\n            }\n\n            // 跳转到指定页\n            function goToSlide(index) {\n                if (index < 0) index = 0;\n                if (index >= totalSlides) index = totalSlides - 1;\n                currentIndex = index;\n                track.style.transform = 'translateX(' + (-currentIndex * 1280) + 'px)';\n                updateDots();\n            }\n\n            // 上一页\n            window.prevSlide = function() {\n                goToSlide(currentIndex - 1);\n            };\n\n            // 下一页\n            window.nextSlide = function() {\n                goToSlide(currentIndex + 1);\n            };\n\n            // 键盘导航\n            document.addEventListener('keydown', function(e) {\n                if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {\n                    e.preventDefault();\n                    window.nextSlide();\n                } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {\n                    e.preventDefault();\n                    window.prevSlide();\n                }\n            });\n\n            // 初始化\n            goToSlide(0);\n        })();\n    </script>\n\n</body>\n</html>"
}